# Postgres (Vercel Postgres / Neon). Copia el connection string que te da el dashboard.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Canal(es) de notificación activos: console | telegram | email (separados por coma)
NOTIFICATION_CHANNEL="console"

# Telegram (opcional, si NOTIFICATION_CHANNEL incluye "telegram")
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Email / SMTP (opcional, si NOTIFICATION_CHANNEL incluye "email")
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
NOTIFICATION_EMAIL_TO=""

# Programación del cron (formato cron estándar). Por defecto: todos los días a las 8am.
CRON_SCHEDULE="0 8 * * *"

# Secreto opcional para proteger /api/cron/check-alerts si se dispara desde un cron externo.
CRON_SECRET=""
